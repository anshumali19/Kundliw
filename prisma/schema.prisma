datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  ASSOCIATE
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum OrderStatus {
  ORDER_RECEIVED
  KUNDLI_IN_PROGRESS
  KUNDLI_COMPLETE
  DISPATCHED
  DELIVERED
  EXECUTION_COMPLETE
}

enum PaymentMode {
  RAZORPAY
  MANUAL_UPI
  MANUAL_BANK
  MANUAL_QR
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  PAID
  FAILED
  REFUNDED
}

enum RequestType {
  SERVICE_BOOKING
  KUNDLI_REQUEST
  KUNDLI_MATCHING
  PRASHNA_KUNDLI
}

enum AssociateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CommissionStatus {
  PENDING // order created, payment not yet confirmed
  EARNED // order paid, available for payout
  PAID // included in a payout that the admin marked as paid
  CANCELLED // order expired, failed or refunded
}

enum PayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum BannerPosition {
  TOP
  BOTTOM
  LEFT
  RIGHT
}

enum BannerType {
  STATIC
  CAROUSEL
}

enum MarqueePosition {
  TOP
  BOTTOM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  associate     AssociateProfile?
  orders        Order[]
  vaultFiles    VaultFile[]
  statusChanges OrderStatusEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OtpVerification {
  id         String    @id @default(cuid())
  phone      String
  otpHash    String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  titleEn         String
  titleHi         String
  taglineEn       String?
  taglineHi       String?
  descriptionEn   String   @db.Text
  descriptionHi   String   @db.Text
  highlightsEn    String[]
  highlightsHi    String[]
  notesEn         String?  @db.Text
  notesHi         String?  @db.Text
  icon            String?
  imageUrl        String?
  itineraryEn     String?  @db.Text
  itineraryHi     String?  @db.Text
  samagriEn       String?  @db.Text
  samagriHi       String?  @db.Text
  youtubeUrl      String?
  additionalLinks Json? // Array of { labelEn: string, labelHi: string, url: string }
  orderIndex      Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plans  Plan[]
  orders Order[]
}

model Plan {
  id                  String   @id @default(cuid())
  serviceId           String
  service             Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  slug                String
  titleEn             String
  titleHi             String
  descriptionEn       String   @db.Text
  descriptionHi       String   @db.Text
  pricePaise          Int // Price in paise (e.g. 110000 = Rs 1100.00)
  originalPricePaise  Int? // Strike-through original price in paise
  deliveryDays        Int      @default(3)
  pages               Int?
  hasCall             Boolean  @default(false)
  callDurationMinutes Int?
  featuresEn          String[]
  featuresHi          String[]
  programEn           String?  @db.Text
  programHi           String?  @db.Text
  preparationEn       String?  @db.Text
  preparationHi       String?  @db.Text
  samagriEn           String?  @db.Text
  samagriHi           String?  @db.Text
  itineraryEn         String?  @db.Text
  itineraryHi         String?  @db.Text
  imageUrl            String?
  youtubeUrl          String?
  additionalLinks     Json?
  isPopular           Boolean  @default(false)
  orderIndex          Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  orders Order[]

  @@unique([serviceId, slug])
}

model Offer {
  id                 String       @id @default(cuid())
  code               String       @unique
  titleEn            String
  titleHi            String
  discountType       DiscountType @default(FLAT)
  discountValuePaise Int // Amount in paise for FLAT (e.g. 50000 for Rs 500) or integer percent for PERCENTAGE (e.g. 25)
  maxDiscountPaise   Int? // Max discount ceiling in paise
  minOrderValuePaise Int          @default(0)
  usageLimit         Int?
  usedCount          Int          @default(0)
  perUserLimit       Int          @default(1) // 0 = unlimited uses per customer
  serviceSlugs       String[]     @default([]) // empty = valid for every service
  planIds            String[]     @default([]) // empty = valid for every plan of the chosen services
  showOnPlan         Boolean      @default(false) // list this offer next to its plans so customers can tap to apply
  validFrom          DateTime     @default(now())
  validUntil         DateTime?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())

  orders Order[]
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique // Sequential e.g. "MKJK-2026-0001"
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceId   String?
  service     Service?    @relation(fields: [serviceId], references: [id])
  planId      String?
  plan        Plan?       @relation(fields: [planId], references: [id])
  offerId     String?
  offer       Offer?      @relation(fields: [offerId], references: [id])
  offerCode   String? // Snapshot of coupon used
  slotId      String?
  slot        Slot?       @relation(fields: [slotId], references: [id])
  requestType RequestType @default(SERVICE_BOOKING)

  status       OrderStatus        @default(ORDER_RECEIVED)
  statusEvents OrderStatusEvent[]

  // Astrological / Jataka details
  jatakaDetails Json // { name, phone, email, gender, dob, tob, pob, lat, lng, gotra, nakshatra, gemstones, language, queries, partnerDetails }

  // Billing & GST (all in paise)
  baseAmountPaise     Int
  discountAmountPaise Int     @default(0)
  taxableAmountPaise  Int
  gstRateBasisPoints  Int     @default(1800) // 18.00% = 1800 bps
  gstAmountPaise      Int
  netAmountPaise      Int
  invoiceNumber       String? @unique // Sequential e.g. "INV-2026-0001"
  gstin               String? // Snapshot of Kendra GSTIN at order time

  // Payment
  paymentMode        PaymentMode   @default(RAZORPAY)
  paymentStatus      PaymentStatus @default(PENDING)
  idempotencyKey     String?       @unique
  expiresAt          DateTime?
  rejectionReason    String?       @db.Text
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  manualPaymentProof String?
  manualPaymentRef   String?

  // Associate referral attribution and appointment approval
  associateId       String?
  associate         AssociateProfile?  @relation(fields: [associateId], references: [id], onDelete: SetNull)
  commission        Commission?
  appointmentStatus AppointmentStatus?
  appointmentNote   String?            @db.Text

  courierName    String?
  trackingNumber String?
  adminNotes     String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vaultFiles VaultFile[]

  @@index([userId])
  @@index([status])
  @@index([associateId])
}

model OrderStatusEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  changedById String?
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

model Slot {
  id          String   @id @default(cuid())
  date        DateTime // Slot calendar date
  startTime   String // e.g. "10:00"
  endTime     String // e.g. "10:30"
  capacity    Int      @default(1)
  bookedCount Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([date, isActive])
}

model AssociateProfile {
  id                    String          @id @default(cuid())
  userId                String          @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode          String          @unique
  status                AssociateStatus @default(PENDING)
  rejectionReason       String?         @db.Text
  reviewedAt            DateTime?
  notes                 String?         @db.Text
  customCommissionType  DiscountType?
  customCommissionValue Int?
  payoutUpi             String?
  payoutAccountHolder   String?
  payoutAccountNumber   String?
  payoutIfsc            String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  orders      Order[]
  commissions Commission[]
  payouts     PayoutRequest[]

  @@index([status])
}

// Commission rule precedence: plan rule > service rule > global rule (serviceId and planId both null).
model CommissionRule {
  id        String       @id @default(cuid())
  serviceId String?
  planId    String?
  type      DiscountType // PERCENTAGE: value is basis points (1000 = 10%). FLAT: value is paise.
  value     Int
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([serviceId])
  @@index([planId])
}

model Commission {
  id          String           @id @default(cuid())
  orderId     String           @unique
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  associateId String
  associate   AssociateProfile @relation(fields: [associateId], references: [id], onDelete: Cascade)
  amountPaise Int
  status      CommissionStatus @default(PENDING)
  payoutId    String?
  payout      PayoutRequest?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([associateId, status])
}

model PayoutRequest {
  id               String           @id @default(cuid())
  associateId      String
  associate        AssociateProfile @relation(fields: [associateId], references: [id], onDelete: Cascade)
  amountPaise      Int
  status           PayoutStatus     @default(REQUESTED)
  note             String?          @db.Text
  paymentReference String?
  createdAt        DateTime         @default(now())
  processedAt      DateTime?
  commissions      Commission[]

  @@index([associateId, status])
}

model Counter {
  id  String @id // e.g. "ORDER_SEQ", "INVOICE_SEQ"
  seq Int    @default(0)
}

model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

model VaultFile {
  id             String   @id @default(cuid())
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleEn        String
  titleHi        String
  fileName       String
  storageKey     String // Internal private storage path
  fileSize       Int
  mimeType       String   @default("application/pdf")
  uploadedByRole String   @default("ADMIN") // ADMIN, USER or ASSOCIATE
  uploadedAt     DateTime @default(now())

  @@index([userId])
}

model RateLimit {
  id         String   @id @default(cuid())
  scope      String // e.g. "OTP_PHONE", "OTP_IP", "ADMIN_LOGIN_EMAIL", "ADMIN_LOGIN_IP"
  identifier String // e.g. Phone number, IP address, or email
  count      Int      @default(1)
  windowEnd  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scope, identifier])
  @@index([scope, identifier, windowEnd])
}

model AdminSettings {
  id                       String   @id @default("default")
  siteNameEn               String?
  siteNameHi               String?
  phone1                   String?
  phone2                   String?
  email                    String?
  addressEn                String?  @db.Text
  addressHi                String?  @db.Text
  city                     String?
  latitude                 Float?
  longitude                Float?
  timezone                 String?
  upiVpa                   String?
  bankAccountName          String?
  bankAccountNumber        String?
  bankIfsc                 String?
  bankName                 String?
  qrCodeUrl                String?
  gstin                    String?
  defaultGstRateBps        Int?     @default(1800)
  socialFacebook           String?
  socialTwitter            String?
  socialInstagram          String?
  socialYoutube            String?
  socialWhatsapp           String?
  socialTelegram           String?
  googleMapEmbedUrl        String?  @db.Text
  googleAnalyticsId        String?
  // Encrypted Third-Party Credentials (Encrypted at rest with AES-256-GCM)
  encRazorpayKeyId         String?
  encRazorpayKeySecret     String?
  encRazorpayWebhookSecret String?
  encMsg91AuthKey          String?
  encMsg91SenderId         String?
  encMsg91OtpTemplateId    String?
  encSmtpHost              String?
  encSmtpPort              Int?
  encSmtpUser              String?
  encSmtpPass              String?
  encSmtpFrom              String?
  encGoogleClientId        String?
  encGoogleClientSecret    String?
  encFacebookAppId         String?
  encFacebookAppSecret     String?
  encAstrosageUserId       String?
  encAstrosageApiKey       String?
  astrosageEmbedUrl        String?  @default("https://www.astrosage.com/freekundli/")
  // Android app download section (website page and QR code)
  appDownloadUrl           String?
  // Map shown on the Contact page and footer (admin chooses the place)
  mapEnabled               Boolean  @default(true)
  mapZoom                  Int      @default(15)
  mapLatitude              Float?
  mapLongitude             Float?
  mapLabelEn               String?
  mapLabelHi               String?
  // Associate programme rules
  associatesEnabled        Boolean  @default(true)
  associateAutoApprove     Boolean  @default(false)
  associateMinPayoutPaise  Int      @default(50000)
  associateReferralDays    Int      @default(30)
  associateTermsEn         String?  @db.Text
  associateTermsHi         String?  @db.Text
  // Backups
  backupAutoEnabled        Boolean  @default(true)
  backupKeepDaily          Int      @default(7)
  backupKeepWeekly         Int      @default(4)
  backupKeepMonthly        Int      @default(12)
  // Chatbot Settings
  chatbotEnabled           Boolean  @default(true)
  chatbotWelcomeEn         String?  @db.Text
  chatbotWelcomeHi         String?  @db.Text
  whatsappNumber           String?
  updatedAt                DateTime @updatedAt
}

model ChatbotQA {
  id           String   @id @default(cuid())
  questionEn   String   @db.Text
  questionHi   String   @db.Text
  answerEn     String   @db.Text
  answerHi     String   @db.Text
  keywords     String[] // Search tokens, e.g. ["pricing", "fees", "dakshina"]
  quickReplyEn String? // Chip button text
  quickReplyHi String?
  category     String   @default("GENERAL") // GENERAL, SERVICES, MUHURTA, KUNDLI, CONTACT
  orderIndex   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, isActive])
}

model ContactEnquiry {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String
  subject    String?
  message    String   @db.Text
  source     String   @default("CONTACT_PAGE") // CONTACT_PAGE, CHATBOT_TICKET, SERVICE_MODAL
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isResolved, createdAt])
}

model MarqueeItem {
  id           String          @id @default(cuid())
  textEn       String
  textHi       String
  speedSec     Int             @default(30)
  fontSize     Int             @default(13) // px
  bgColor      String          @default("var(--secondary)")
  textColor    String          @default("var(--on-secondary)")
  position     MarqueePosition @default(BOTTOM)
  isActive     Boolean         @default(true)
  pauseOnHover Boolean         @default(true)
  allowClose   Boolean         @default(true)
  orderIndex   Int             @default(0)
  createdAt    DateTime        @default(now())
}

model Banner {
  id         String         @id @default(cuid())
  titleEn    String
  titleHi    String
  subtitleEn String?
  subtitleHi String?
  imageUrl   String
  linkUrl    String?
  position   BannerPosition @default(RIGHT)
  type       BannerType     @default(STATIC)
  isActive   Boolean        @default(true)
  orderIndex Int            @default(0)
  createdAt  DateTime       @default(now())
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  titleEn         String
  titleHi         String
  excerptEn       String?   @db.Text
  excerptHi       String?   @db.Text
  contentEn       String    @db.Text
  contentHi       String    @db.Text
  coverImage      String?
  youtubeUrl      String?
  additionalLinks Json? // Array of { labelEn: string, labelHi: string, url: string }
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model OtherService {
  id              String   @id @default(cuid())
  slug            String   @unique
  titleEn         String
  titleHi         String
  taglineEn       String?
  taglineHi       String?
  descriptionEn   String   @db.Text
  descriptionHi   String   @db.Text
  imageUrl        String?
  actionUrl       String?
  actionTextEn    String?  @default("Visit Portal / Learn More")
  actionTextHi    String?  @default("पोर्टल पर जाएं / विवरण देखें")
  youtubeUrl      String?
  additionalLinks Json?
  orderIndex      Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Testimonial {
  id              String   @id @default(cuid())
  authorNameEn    String
  authorNameHi    String
  authorTitleEn   String
  authorTitleHi   String
  cityEn          String
  cityHi          String
  quoteEn         String   @db.Text
  quoteHi         String   @db.Text
  rating          Int      @default(5)
  isVerified      Boolean  @default(true)
  photoUrl        String?
  youtubeUrl      String?
  additionalLinks Json?
  isActive        Boolean  @default(true)
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
}

model MediaGalleryItem {
  id              String   @id @default(cuid())
  titleEn         String
  titleHi         String
  captionEn       String?
  captionHi       String?
  imageUrl        String
  videoUrl        String?
  mediaType       String   @default("IMAGE") // IMAGE, VIDEO, YOUTUBE
  externalLink    String?
  additionalLinks Json?
  isActive        Boolean  @default(true)
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
}

model FounderProfile {
  id              String   @id @default("default")
  nameEn          String   @default("Founder Name")
  nameHi          String   @default("संस्थापक का नाम")
  designationEn   String   @default("Founder & Chief Astrologer")
  designationHi   String   @default("संस्थापक एवं मुख्य ज्योतिषाचार्य")
  roleEn          String   @default("Vedic Astrological Guidance & Direction")
  roleHi          String   @default("वैदिक ज्योतिष मार्गदर्शन एवं दिशा-निर्देशन")
  photoUrl        String?
  bioEn           String   @db.Text
  bioHi           String   @db.Text
  youtubeUrl      String?
  additionalLinks Json? // Array of { labelEn: string, labelHi: string, url: string }
  blocks          Json?
  footerNoteEn    String?  @db.Text
  footerNoteHi    String?  @db.Text
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model FaqItem {
  id         String   @id @default(cuid())
  questionEn String
  questionHi String
  answerEn   String   @db.Text
  answerHi   String   @db.Text
  category   String   @default("GENERAL") // GENERAL, KUNDLI, PUJA, PAYMENT
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category, isActive, orderIndex])
}

model StaticPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  titleEn      String
  titleHi      String
  contentEn    String   @db.Text
  contentHi    String   @db.Text
  blocks       Json?
  isActive     Boolean  @default(true)
  showInFooter Boolean  @default(false)
  showInMenu   Boolean  @default(false)
  metaDescEn   String?  @db.Text
  metaDescHi   String?  @db.Text
  updatedAt    DateTime @updatedAt
}

model PanchangCache {
  id         String   @id @default(cuid())
  dateString String // e.g. "2026-10-23"
  city       String // e.g. "varanasi"
  dataJson   Json
  cachedAt   DateTime @default(now())

  @@unique([dateString, city])
}

model TranslationOverride {
  id        String   @id @default(cuid())
  locale    String // "hi" or "en"
  namespace String // e.g. "nav", "common", "footer", "home", "services", "booking", etc.
  key       String // e.g. "book_consultation" or deep dot path "steps.step1"
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key])
  @@index([locale, namespace])
}

// Official documents shown to users (GST, MSME, trademark, ISO and so on)
model Credential {
  id             String   @id @default(cuid())
  kind           String   @default("OTHER") // GST, MSME, TRADEMARK, ISO, OTHER
  titleEn        String
  titleHi        String
  descriptionEn  String?  @db.Text
  descriptionHi  String?  @db.Text
  documentNumber String?
  fileUrl        String
  fileName       String
  mimeType       String
  isActive       Boolean  @default(true)
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Stored copies of the site's content and records (compressed JSON)
model BackupRecord {
  id        String   @id @default(cuid())
  kind      String // MANUAL, DAILY, WEEKLY, MONTHLY
  sizeBytes Int
  tables    Int      @default(0)
  rows      Int      @default(0)
  data      Bytes
  createdBy String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// Website settings the super admin edits from the panel (one row per section).
model SiteConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
