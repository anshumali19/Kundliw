datasource db {
  provider = "mysql"
  url       = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  ASSOCIATE
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum OrderStatus {
  ORDER_RECEIVED
  KUNDLI_IN_PROGRESS
  KUNDLI_COMPLETE
  DISPATCHED
  DELIVERED
  EXECUTION_COMPLETE
}

enum PaymentMode {
  RAZORPAY
  MANUAL_UPI
  MANUAL_BANK
  MANUAL_QR
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  PAID
  FAILED
  REFUNDED
}

enum RequestType {
  SERVICE_BOOKING
  KUNDLI_REQUEST
  KUNDLI_MATCHING
  PRASHNA_KUNDLI
}

enum AssociateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CommissionStatus {
  PENDING // order created, payment not yet confirmed
  EARNED // order paid, available for payout
  PAID // included in a payout that the admin marked as paid
  CANCELLED // order expired, failed or refunded
}

enum PayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum BannerPosition {
  TOP
  BOTTOM
  LEFT
  RIGHT
}

enum BannerType {
  STATIC
  CAROUSEL
}

enum MarqueePosition {
  TOP
  BOTTOM
}

model User {
  id            String    @id @default(cuid())
  name          String? @db.Text
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String? @db.Text
  emailVerified DateTime?
  image         String? @db.Text
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  associate     AssociateProfile?
  orders        Order[]
  vaultFiles    VaultFile[]
  statusChanges OrderStatusEvent[]
  supportTickets SupportTicket[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String @db.Text
  provider          String
  providerAccountId String
  refresh_token     String? @db.MediumText
  access_token      String? @db.MediumText
  expires_at        Int?
  token_type        String? @db.Text
  scope             String? @db.Text
  id_token          String? @db.MediumText
  session_state     String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OtpVerification {
  id         String    @id @default(cuid())
  phone      String
  otpHash    String @db.Text
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  titleEn         String @db.Text
  titleHi         String @db.Text
  taglineEn       String? @db.Text
  taglineHi       String? @db.Text
  descriptionEn   String   @db.MediumText
  descriptionHi   String   @db.MediumText
  highlightsEn    Json?
  highlightsHi    Json?
  notesEn         String?  @db.MediumText
  notesHi         String?  @db.MediumText
  icon            String? @db.Text
  imageUrl        String? @db.Text
  itineraryEn     String?  @db.MediumText
  itineraryHi     String?  @db.MediumText
  samagriEn       String?  @db.MediumText
  samagriHi       String?  @db.MediumText
  youtubeUrl      String? @db.Text
  additionalLinks Json? // Array of { labelEn: string, labelHi: string, url: string }
  /// Demos shown on the service page: [{ kind: link|image|video|social, labelEn, labelHi, url }]
  demos           Json?
  /// When set, this service is paid for on that other website, not here
  externalPayUrl  String? @db.Text
  externalPayNoteEn String? @db.Text
  externalPayNoteHi String? @db.Text
  orderIndex      Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plans    Plan[]
  packages ServicePackage[]
  orders   Order[]
}

/// A package inside a service, for example Service = Yagya, Package = Sadharan / Madhyam / Uttam.
/// Each package holds its own plans (different material costs).
model ServicePackage {
  id            String   @id @default(cuid())
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  slug          String
  titleEn       String @db.Text
  titleHi       String @db.Text
  descriptionEn String?  @db.MediumText
  descriptionHi String?  @db.MediumText
  numberOfDays  Int?
  startDate     DateTime?
  endDate       DateTime?
  /// Most bookings this package can take (empty = no limit). Used to close it when full.
  seats         Int?
  /// Day by day programme: [{ titleEn, titleHi, detailsEn, detailsHi }]
  itineraryDays Json?
  inclusionsEn  Json?
  inclusionsHi  Json?
  exclusionsEn  Json?
  exclusionsHi  Json?
  materialsEn   Json?
  materialsHi   Json?
  youtubeUrl    String? @db.Text
  imageUrl      String? @db.Text
  additionalLinks Json?
  orderIndex    Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plans Plan[]

  @@unique([serviceId, slug])
}

model Plan {
  id                  String   @id @default(cuid())
  serviceId           String
  service             Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  packageId           String?
  package             ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  slug                String
  titleEn             String @db.Text
  titleHi             String @db.Text
  descriptionEn       String   @db.MediumText
  descriptionHi       String   @db.MediumText
  pricePaise          Int // Price in paise (e.g. 110000 = Rs 1100.00)
  originalPricePaise  Int? // Strike-through original price in paise
  deliveryDays        Int      @default(3)
  pages               Int?
  hasCall             Boolean  @default(false)
  callDurationMinutes Int?
  featuresEn          Json?
  featuresHi          Json?
  programEn           String?  @db.MediumText
  programHi           String?  @db.MediumText
  preparationEn       String?  @db.MediumText
  preparationHi       String?  @db.MediumText
  samagriEn           String?  @db.MediumText
  samagriHi           String?  @db.MediumText
  itineraryEn         String?  @db.MediumText
  itineraryHi         String?  @db.MediumText
  imageUrl            String? @db.Text
  youtubeUrl          String? @db.Text
  additionalLinks     Json?
  isPopular           Boolean  @default(false)
  orderIndex          Int      @default(0)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  orders Order[]

  @@unique([serviceId, slug])
}

model Offer {
  id                 String       @id @default(cuid())
  code               String       @unique
  titleEn            String @db.Text
  titleHi            String @db.Text
  discountType       DiscountType @default(FLAT)
  discountValuePaise Int // Amount in paise for FLAT (e.g. 50000 for Rs 500) or integer percent for PERCENTAGE (e.g. 25)
  maxDiscountPaise   Int? // Max discount ceiling in paise
  minOrderValuePaise Int          @default(0)
  usageLimit         Int?
  usedCount          Int          @default(0)
  perUserLimit       Int          @default(1) // 0 = unlimited uses per customer
  serviceSlugs       Json? // empty = valid for every service
  planIds            Json? // empty = valid for every plan of the chosen services
  showOnPlan         Boolean      @default(false) // list this offer next to its plans so customers can tap to apply
  autoApply          Boolean      @default(false) // applied automatically at booking, no code needed
  showInPopup        Boolean      @default(true) // listed in the offers pop-up shown to visitors
  validFrom          DateTime     @default(now())
  validUntil         DateTime?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())

  orders Order[]
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique // Sequential e.g. "MKJK-2026-0001"
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceId   String?
  service     Service?    @relation(fields: [serviceId], references: [id])
  planId      String?
  plan        Plan?       @relation(fields: [planId], references: [id])
  /// Further plans booked together with the first (same service, at most 2). Empty for a single-plan order.
  extraPlanIds Json?
  offerId     String?
  offer       Offer?      @relation(fields: [offerId], references: [id])
  offerCode   String? @db.Text // Snapshot of coupon used
  slotId      String?
  slot        Slot?       @relation(fields: [slotId], references: [id])
  requestType RequestType @default(SERVICE_BOOKING)

  status       OrderStatus        @default(ORDER_RECEIVED)
  statusEvents OrderStatusEvent[]

  // Astrological / Jataka details
  jatakaDetails Json // { name, phone, email, gender, dob, tob, pob, lat, lng, gotra, nakshatra, gemstones, language, queries, partnerDetails }

  // Billing & GST (all in paise)
  baseAmountPaise     Int
  discountAmountPaise Int     @default(0)
  taxableAmountPaise  Int
  gstRateBasisPoints  Int     @default(1800) // 18.00% = 1800 bps
  gstAmountPaise      Int
  netAmountPaise      Int
  invoiceNumber       String? @unique // Sequential e.g. "INV-2026-0001"
  gstin               String? @db.Text // Snapshot of Kendra GSTIN at order time

  // Payment
  paymentMode        PaymentMode   @default(RAZORPAY)
  paymentStatus      PaymentStatus @default(PENDING)
  idempotencyKey     String?       @unique
  expiresAt          DateTime?
  rejectionReason    String?       @db.MediumText
  razorpayOrderId    String? @db.Text
  razorpayPaymentId  String? @db.Text
  razorpaySignature  String? @db.Text
  manualPaymentProof String? @db.Text
  manualPaymentRef   String? @db.Text

  // Associate referral attribution and appointment approval
  associateId       String?
  associate         AssociateProfile?  @relation(fields: [associateId], references: [id], onDelete: SetNull)
  commission        Commission?
  appointmentStatus AppointmentStatus?
  appointmentNote   String?            @db.MediumText

  /// Cancellation and refund (the money itself is sent by the Kendra from its payment account)
  cancelledAt        DateTime?
  cancelReason       String?   @db.MediumText
  /// USER, ADMIN or UPGRADE
  cancelledBy        String? @db.Text
  /// REQUESTED (waiting for the Kendra), SENT, or CREDITED (moved to an upgraded order)
  refundStatus       String? @db.Text
  refundAmountPaise  Int?
  refundedAt         DateTime?
  /// Set on an order that upgrades an earlier order to a higher plan
  upgradeFromOrderId String?

  courierName    String? @db.Text
  trackingNumber String? @db.Text
  adminNotes     String?  @db.MediumText
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vaultFiles VaultFile[]
  /// One row per extra plan bought together with the first. Lets the package seat count use an index
  /// (MySQL cannot search inside a list column). Kept in step with extraPlanIds by createBookingOrder.
  extraPlans OrderExtraPlan[]

  @@index([userId])
  @@index([status])
  @@index([associateId])
  @@index([upgradeFromOrderId])
}

model OrderExtraPlan {
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  planId  String

  @@id([orderId, planId])
  @@index([planId])
}

model OrderStatusEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String? @db.Text
  changedById String?
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

model Slot {
  id          String   @id @default(cuid())
  date        DateTime // Slot calendar date
  startTime   String @db.Text // e.g. "10:00"
  endTime     String @db.Text // e.g. "10:30"
  capacity    Int      @default(1)
  bookedCount Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([date, isActive])
}

model AssociateProfile {
  id                    String          @id @default(cuid())
  userId                String          @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode          String          @unique
  status                AssociateStatus @default(PENDING)
  rejectionReason       String?         @db.MediumText
  reviewedAt            DateTime?
  notes                 String?         @db.MediumText
  customCommissionType  DiscountType?
  customCommissionValue Int?
  payoutUpi             String? @db.Text
  payoutAccountHolder   String? @db.Text
  payoutAccountNumber   String? @db.Text
  payoutIfsc            String? @db.Text
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  orders      Order[]
  commissions Commission[]
  payouts     PayoutRequest[]

  @@index([status])
}

// Commission rule precedence: plan rule > service rule > global rule (serviceId and planId both null).
model CommissionRule {
  id        String       @id @default(cuid())
  serviceId String?
  planId    String?
  type      DiscountType // PERCENTAGE: value is basis points (1000 = 10%). FLAT: value is paise.
  value     Int
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([serviceId])
  @@index([planId])
}

model Commission {
  id          String           @id @default(cuid())
  orderId     String           @unique
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  associateId String
  associate   AssociateProfile @relation(fields: [associateId], references: [id], onDelete: Cascade)
  amountPaise Int
  status      CommissionStatus @default(PENDING)
  payoutId    String?
  payout      PayoutRequest?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([associateId, status])
}

model PayoutRequest {
  id               String           @id @default(cuid())
  associateId      String
  associate        AssociateProfile @relation(fields: [associateId], references: [id], onDelete: Cascade)
  amountPaise      Int
  status           PayoutStatus     @default(REQUESTED)
  note             String?          @db.MediumText
  paymentReference String? @db.Text
  createdAt        DateTime         @default(now())
  processedAt      DateTime?
  commissions      Commission[]

  @@index([associateId, status])
}

model Counter {
  id  String @id // e.g. "ORDER_SEQ", "INVOICE_SEQ"
  seq Int    @default(0)
}

model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String @db.Text
  processedAt DateTime @default(now())
}

model VaultFile {
  id             String   @id @default(cuid())
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleEn        String @db.Text
  titleHi        String @db.Text
  fileName       String @db.Text
  storageKey     String @db.Text // Internal private storage path
  fileSize       Int
  mimeType       String   @default("application/pdf")
  uploadedByRole String   @default("ADMIN") // ADMIN, USER or ASSOCIATE
  uploadedAt     DateTime @default(now())

  @@index([userId])
}

model RateLimit {
  id         String   @id @default(cuid())
  scope      String // e.g. "OTP_PHONE", "OTP_IP", "ADMIN_LOGIN_EMAIL", "ADMIN_LOGIN_IP"
  identifier String // e.g. Phone number, IP address, or email
  count      Int      @default(1)
  windowEnd  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scope, identifier])
  @@index([scope, identifier, windowEnd])
}

model AdminSettings {
  id                       String   @id @default("default")
  siteNameEn               String? @db.Text
  siteNameHi               String? @db.Text
  phone1                   String? @db.Text
  phone2                   String? @db.Text
  email                    String? @db.Text
  addressEn                String?  @db.MediumText
  addressHi                String?  @db.MediumText
  city                     String? @db.Text
  latitude                 Float?
  longitude                Float?
  timezone                 String? @db.Text
  upiVpa                   String? @db.Text
  bankAccountName          String? @db.Text
  bankAccountNumber        String? @db.Text
  bankIfsc                 String? @db.Text
  bankName                 String? @db.Text
  qrCodeUrl                String? @db.Text
  gstin                    String? @db.Text
  defaultGstRateBps        Int?     @default(1800)
  socialFacebook           String? @db.Text
  socialTwitter            String? @db.Text
  socialInstagram          String? @db.Text
  socialYoutube            String? @db.Text
  socialWhatsapp           String? @db.Text
  socialTelegram           String? @db.Text
  googleMapEmbedUrl        String?  @db.MediumText
  googleAnalyticsId        String? @db.Text
  // Encrypted Third-Party Credentials (Encrypted at rest with AES-256-GCM)
  encRazorpayKeyId         String? @db.Text
  encRazorpayKeySecret     String? @db.Text
  encRazorpayWebhookSecret String? @db.Text
  encMsg91AuthKey          String? @db.Text
  encMsg91SenderId         String? @db.Text
  encMsg91OtpTemplateId    String? @db.Text
  encSmtpHost              String? @db.Text
  encSmtpPort              Int?
  encSmtpUser              String? @db.Text
  encSmtpPass              String? @db.Text
  encSmtpFrom              String? @db.Text
  encGoogleClientId        String? @db.Text
  encGoogleClientSecret    String? @db.Text
  encFacebookAppId         String? @db.Text
  encFacebookAppSecret     String? @db.Text
  encAstrosageUserId       String? @db.Text
  encAstrosageApiKey       String? @db.Text
  encWhatsappAccessToken   String? @db.Text
  encWhatsappPhoneNumberId String? @db.Text
  encWhatsappVerifyToken   String? @db.Text
  encWhatsappAppSecret     String? @db.Text
  /// When on, visitors see a "back soon" page; the admin and the sign-in pages keep working
  maintenanceMode          Boolean  @default(false)
  maintenanceMessageEn     String? @db.Text
  maintenanceMessageHi     String? @db.Text
  astrosageEmbedUrl        String? @db.VarChar(1000)  @default("https://www.astrosage.com/freekundli/")
  // Android app download section (website page and QR code)
  appDownloadUrl           String? @db.Text
  // Map shown on the Contact page and footer (admin chooses the place)
  mapEnabled               Boolean  @default(true)
  mapZoom                  Int      @default(15)
  mapLatitude              Float?
  mapLongitude             Float?
  mapLabelEn               String? @db.Text
  mapLabelHi               String? @db.Text
  // Associate programme rules
  associatesEnabled        Boolean  @default(true)
  associateAutoApprove     Boolean  @default(false)
  associateMinPayoutPaise  Int      @default(50000)
  associateReferralDays    Int      @default(30)
  associateTermsEn         String?  @db.MediumText
  associateTermsHi         String?  @db.MediumText
  // Backups
  backupAutoEnabled        Boolean  @default(true)
  backupKeepDaily          Int      @default(7)
  backupKeepWeekly         Int      @default(4)
  backupKeepMonthly        Int      @default(12)
  // Chatbot Settings
  chatbotEnabled           Boolean  @default(true)
  chatbotWelcomeEn         String?  @db.MediumText
  chatbotWelcomeHi         String?  @db.MediumText
  whatsappNumber           String? @db.Text
  updatedAt                DateTime @updatedAt
}

model ChatbotQA {
  id           String   @id @default(cuid())
  questionEn   String   @db.MediumText
  questionHi   String   @db.MediumText
  answerEn     String   @db.MediumText
  answerHi     String   @db.MediumText
  keywords     Json? // Search tokens, e.g. ["pricing", "fees", "dakshina"]
  quickReplyEn String? @db.Text // Chip button text
  quickReplyHi String? @db.Text
  category     String   @default("GENERAL") // GENERAL, SERVICES, MUHURTA, KUNDLI, CONTACT
  orderIndex   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, isActive])
}

model ContactEnquiry {
  id         String   @id @default(cuid())
  name       String @db.Text
  email      String? @db.Text
  phone      String @db.Text
  subject    String? @db.Text
  message    String   @db.MediumText
  source     String   @default("CONTACT_PAGE") // CONTACT_PAGE, CHATBOT_TICKET, SERVICE_MODAL
  isResolved Boolean  @default(false)
  /// Lead stage: NEW, CONTACTED or CLOSED (CLOSED also sets isResolved)
  leadStatus String   @default("NEW")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isResolved, createdAt])
}

model MarqueeItem {
  id           String          @id @default(cuid())
  textEn       String @db.Text
  textHi       String @db.Text
  speedSec     Int             @default(30)
  fontSize     Int             @default(13) // px
  bgColor      String @db.VarChar(100)          @default("var(--secondary)")
  textColor    String @db.VarChar(100)          @default("var(--on-secondary)")
  position     MarqueePosition @default(BOTTOM)
  isActive     Boolean         @default(true)
  pauseOnHover Boolean         @default(true)
  allowClose   Boolean         @default(true)
  orderIndex   Int             @default(0)
  createdAt    DateTime        @default(now())
}

model Banner {
  id         String         @id @default(cuid())
  titleEn    String @db.Text
  titleHi    String @db.Text
  subtitleEn String? @db.Text
  subtitleHi String? @db.Text
  imageUrl   String @db.Text
  linkUrl    String? @db.Text
  position   BannerPosition @default(RIGHT)
  type       BannerType     @default(STATIC)
  isActive   Boolean        @default(true)
  orderIndex Int            @default(0)
  createdAt  DateTime       @default(now())
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  titleEn         String @db.Text
  titleHi         String @db.Text
  excerptEn       String?   @db.MediumText
  excerptHi       String?   @db.MediumText
  contentEn       String    @db.MediumText
  contentHi       String    @db.MediumText
  coverImage      String? @db.Text
  youtubeUrl      String? @db.Text
  additionalLinks Json? // Array of { labelEn: string, labelHi: string, url: string }
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model OtherService {
  id              String   @id @default(cuid())
  slug            String   @unique
  titleEn         String @db.Text
  titleHi         String @db.Text
  taglineEn       String? @db.Text
  taglineHi       String? @db.Text
  descriptionEn   String   @db.MediumText
  descriptionHi   String   @db.MediumText
  imageUrl        String? @db.Text
  actionUrl       String? @db.Text
  /// Slug of a bookable Service whose packages, plans and offers this card uses (empty = plain link card)
  serviceSlug     String? @db.Text
  actionTextEn    String? @db.VarChar(500)  @default("Visit Portal / Learn More")
  actionTextHi    String? @db.VarChar(500)  @default("पोर्टल पर जाएं / विवरण देखें")
  /// Nature of the service, for example "Pilgrimage tour" or "Matrimonial platform"
  natureEn        String? @db.Text
  natureHi        String? @db.Text
  numberOfDays    Int?
  startDate       DateTime?
  endDate         DateTime?
  /// Day by day programme: [{ titleEn, titleHi, detailsEn, detailsHi }]
  itineraryDays   Json?
  facebookUrl     String? @db.Text
  whatsappGroupUrl String? @db.Text
  demos           Json?
  youtubeUrl      String? @db.Text
  additionalLinks Json?
  orderIndex      Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Testimonial {
  id              String   @id @default(cuid())
  authorNameEn    String @db.Text
  authorNameHi    String @db.Text
  authorTitleEn   String @db.Text
  authorTitleHi   String @db.Text
  cityEn          String @db.Text
  cityHi          String @db.Text
  quoteEn         String   @db.MediumText
  quoteHi         String   @db.MediumText
  rating          Int      @default(5)
  isVerified      Boolean  @default(true)
  photoUrl        String? @db.Text
  youtubeUrl      String? @db.Text
  additionalLinks Json?
  isActive        Boolean  @default(true)
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
}

model MediaGalleryItem {
  id              String   @id @default(cuid())
  titleEn         String @db.Text
  titleHi         String @db.Text
  captionEn       String? @db.Text
  captionHi       String? @db.Text
  imageUrl        String @db.Text
  videoUrl        String? @db.Text
  mediaType       String   @default("IMAGE") // IMAGE, VIDEO, YOUTUBE
  externalLink    String? @db.Text
  additionalLinks Json?
  isActive        Boolean  @default(true)
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
}

model FounderProfile {
  id              String   @id @default("default")
  nameEn          String @db.VarChar(500)   @default("Founder Name")
  nameHi          String @db.VarChar(500)   @default("संस्थापक का नाम")
  designationEn   String @db.VarChar(500)   @default("Founder & Chief Astrologer")
  designationHi   String @db.VarChar(500)   @default("संस्थापक एवं मुख्य ज्योतिषाचार्य")
  roleEn          String @db.VarChar(500)   @default("Vedic Astrological Guidance & Direction")
  roleHi          String @db.VarChar(500)   @default("वैदिक ज्योतिष मार्गदर्शन एवं दिशा-निर्देशन")
  photoUrl        String? @db.Text
  bioEn           String   @db.MediumText
  bioHi           String   @db.MediumText
  youtubeUrl      String? @db.Text
  additionalLinks Json? // Array of { labelEn: string, labelHi: string, url: string }
  blocks          Json?
  footerNoteEn    String?  @db.MediumText
  footerNoteHi    String?  @db.MediumText
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model FaqItem {
  id         String   @id @default(cuid())
  questionEn String @db.Text
  questionHi String @db.Text
  answerEn   String   @db.MediumText
  answerHi   String   @db.MediumText
  category   String   @default("GENERAL") // GENERAL, KUNDLI, PUJA, PAYMENT
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category, isActive, orderIndex])
}

model StaticPage {
  id           String   @id @default(cuid())
  slug         String   @unique
  titleEn      String @db.Text
  titleHi      String @db.Text
  contentEn    String   @db.MediumText
  contentHi    String   @db.MediumText
  blocks       Json?
  isActive     Boolean  @default(true)
  showInFooter Boolean  @default(false)
  showInMenu   Boolean  @default(false)
  metaDescEn   String?  @db.MediumText
  metaDescHi   String?  @db.MediumText
  updatedAt    DateTime @updatedAt
}

model PanchangCache {
  id         String   @id @default(cuid())
  dateString String // e.g. "2026-10-23"
  city       String // e.g. "varanasi"
  dataJson   Json
  cachedAt   DateTime @default(now())

  @@unique([dateString, city])
}

model TranslationOverride {
  id        String   @id @default(cuid())
  locale    String // "hi" or "en"
  namespace String // e.g. "nav", "common", "footer", "home", "services", "booking", etc.
  key       String // e.g. "book_consultation" or deep dot path "steps.step1"
  value     String   @db.MediumText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, namespace, key])
  @@index([locale, namespace])
}

// Official documents shown to users (GST, MSME, trademark, ISO and so on)
model Credential {
  id             String   @id @default(cuid())
  kind           String   @default("OTHER") // GST, MSME, TRADEMARK, ISO, OTHER
  titleEn        String @db.Text
  titleHi        String @db.Text
  descriptionEn  String?  @db.MediumText
  descriptionHi  String?  @db.MediumText
  documentNumber String? @db.Text
  fileUrl        String @db.Text
  fileName       String @db.Text
  mimeType       String @db.Text
  isActive       Boolean  @default(true)
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Stored copies of the site's content and records (compressed JSON)
model BackupRecord {
  id        String   @id @default(cuid())
  kind      String // MANUAL, DAILY, WEEKLY, MONTHLY
  sizeBytes Int
  tables    Int      @default(0)
  rows      Int      @default(0)
  data      Bytes
  createdBy String? @db.Text
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// Website settings the super admin edits from the panel (one row per section).
model SiteConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id         String   @id @default(cuid())
  nameEn     String @db.Text
  nameHi     String @db.Text
  roleEn     String @db.Text
  roleHi     String @db.Text
  bioEn      String?  @db.MediumText
  bioHi      String?  @db.MediumText
  photoUrl   String? @db.Text
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Chat log of the Kendra's WhatsApp Business number (filled by the webhook and by admin replies)
model WhatsAppMessage {
  id           String   @id @default(cuid())
  waMessageId  String?  @unique
  contactPhone String
  contactName  String? @db.Text
  direction    String @db.Text // IN, OUT
  body         String   @db.MediumText
  status       String   @default("RECEIVED") // RECEIVED, SENT, FAILED
  createdAt    DateTime @default(now())

  @@index([contactPhone, createdAt])
}

/// Sister services desk: Vindhya Vivah Sanskar (matrimony) profiles awaiting or holding approval
model MatrimonyProfile {
  id           String    @id @default(cuid())
  name         String @db.Text
  phone        String @db.Text
  gender       String    @default("FEMALE") // MALE, FEMALE
  dob          String? @db.Text
  city         String? @db.Text
  about        String?   @db.MediumText
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  isPaidMember Boolean   @default(false)
  paidUntil    DateTime?
  notes        String?   @db.MediumText
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

/// Sister services desk: Bharat Darshan vehicles and their drivers
model TravelVehicle {
  id          String   @id @default(cuid())
  name        String @db.Text
  number      String @db.Text
  seats       Int      @default(4)
  driverName  String? @db.Text
  driverPhone String? @db.Text
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests TravelRequest[]
}

/// Sister services desk: Bharat Darshan pilgrimage and tour requests
model TravelRequest {
  id          String         @id @default(cuid())
  name        String @db.Text
  phone       String @db.Text
  destination String @db.Text
  travelDate  DateTime?
  passengers  Int            @default(1)
  vehicleId   String?
  vehicle     TravelVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status      String         @default("NEW") // NEW, CONFIRMED, ONGOING, COMPLETED, CANCELLED
  notes       String?        @db.MediumText
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
}

/// Sister services desk: ITR help desk, one row per document set a client submits
model TaxCase {
  id             String   @id @default(cuid())
  clientName     String @db.Text
  phone          String @db.Text
  assessmentYear String @db.Text
  docType        String @db.Text
  documentUrl    String? @db.Text
  filingStatus   String   @default("RECEIVED") // RECEIVED, IN_PROGRESS, FILED, ACKNOWLEDGED
  ackNumber      String? @db.Text
  notes          String?  @db.MediumText
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([filingStatus])
}

/// A help request raised by a signed-in customer or associate; the admin answers in Admin > Support tickets
model SupportTicket {
  id           String   @id @default(cuid())
  ticketNumber String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String @db.Text
  orderNumber  String? @db.Text // optional: the order the question is about
  topic        String? @db.Text // the ready-made question the customer picked, if any
  contactName    String? @db.Text
  contactEmail   String? @db.Text
  contactPhone   String? @db.Text
  contactAddress String? @db.Text
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages SupportTicketMessage[]

  @@index([userId])
  @@index([status])
}

model SupportTicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromAdmin Boolean       @default(false)
  body      String        @db.MediumText
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}
