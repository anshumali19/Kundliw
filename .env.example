# ==============================================================================
# Maharshi Kanad Jyotish Kendra (https://kanadjyotishkendra.vercel.app/)
# Canonical Environment Configuration Blueprint (.env.example)
#
# DUAL-TIER CREDENTIAL ARCHITECTURE:
# All 3rd-party credentials (Razorpay, MSG91, SMTP, OAuth, AstroSage, GA4) can be:
#   1. Set dynamically in the Admin Panel Vault (/admin/settings/keys) with AES-256-GCM encryption
#   2. Defined below as environment variable fallbacks
# The system checks DB first; if absent, it falls back to these process.env variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & ORM (PostgreSQL)
# ------------------------------------------------------------------------------
# Production connection string (e.g. Supabase, Neon, AWS RDS, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanad_jyotish?schema=public"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-char-secret"
# Canonical URL of the deployment (e.g. https://kanadjyotishkendra.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Initial Admin Password (read on initial seed/setup only; never committed)
INITIAL_ADMIN_PASSWORD="change-me-in-production"

# ------------------------------------------------------------------------------
# 3. CREDENTIALS VAULT ENCRYPTION KEY (AES-256-GCM)
# ------------------------------------------------------------------------------
# Required for encrypting API keys at rest in the database.
# Generate via: openssl rand -base64 32
# WARNING: Store this key securely in password manager / backup. If this key is lost,
# previously encrypted credentials in the database CANNOT be decrypted and must be
# re-saved via the Admin Panel (/admin/settings/keys).
# In production, if this key is missing, the application fails closed.
CREDENTIALS_ENCRYPTION_KEY="replace-with-a-very-secure-32-char-passphrase-here"

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY
# Get from: https://dashboard.razorpay.com/app/keys & Webhooks
# ------------------------------------------------------------------------------
# Publishable Key ID (rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID="rzp_test_placeholder"
# Private Secret Key
RAZORPAY_KEY_SECRET="placeholder_secret"
# Webhook Secret configured in Razorpay Dashboard for signature verification
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook"

# ------------------------------------------------------------------------------
# 5. MSG91 TRANSACTIONAL SMS & OTP GATEWAY
# Get from: https://control.msg91.com/
# ------------------------------------------------------------------------------
# Authentication key from MSG91 dashboard
MSG91_AUTH_KEY=""
# 6-character sender ID approved by DLT (e.g. KANADJ)
MSG91_SENDER_ID=""
# OTP Flow/Template ID approved by DLT
MSG91_OTP_TEMPLATE_ID=""

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL DELIVERY (Transacational Receipts & Charts)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="contact@kanadastro.org"
SMTP_PASS=""
SMTP_FROM="Maharshi Kanad Jyotish Kendra <contact@kanadastro.org>"

# ------------------------------------------------------------------------------
# 7. SOCIAL OAUTH LOGIN (Google Cloud & Meta Developers)
# Google: https://console.cloud.google.com/apis/credentials
# Meta: https://developers.facebook.com/apps
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ------------------------------------------------------------------------------
# 8. ASTROSAGE VEDIC ASTROLOGY CLOUD API
# Get from: https://cloud.astrosage.com/
# ------------------------------------------------------------------------------
ASTROSAGE_USER_ID=""
ASTROSAGE_API_KEY=""

# ------------------------------------------------------------------------------
# 9. GOOGLE ANALYTICS 4
# Get from: https://analytics.google.com/ (Data Streams > Measurement ID)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
GA_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# 10. GOOGLE MAPS EMBED
# Free standard iframe embed link (Zero Google Maps API billing required)
# ------------------------------------------------------------------------------
GOOGLE_MAP_EMBED_URL="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3606.877840131435!2d83.00762957599026!3d25.30831627763878!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x398e2e21759d57a9%3A0xea8f7c94fafe0e52!2sDashashwamedh%20Ghat!5e0!3m2!1sen!2sin!4v1729864000000!5m2!1sen!2sin"

# ------------------------------------------------------------------------------
# 11. PRIVATE CUSTOMER KUNDLI VAULT STORAGE
# ------------------------------------------------------------------------------
VAULT_STORAGE_PATH="./storage/vault"

# ------------------------------------------------------------------------------
# 12. SCHEDULED CRON & PROXY NETWORKING
# ------------------------------------------------------------------------------
# Secret for the scheduled reservation-expiry endpoint.
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to
# /api/cron/expire-orders every 10 minutes (see vercel.json).
# Leave empty to disable the endpoint (it returns 503).
CRON_SECRET=""

# Trust X-Forwarded-For / X-Real-IP from a reverse proxy.
# Vercel and Cloudflare Pages are auto-detected; set this to "true" only when
# the app runs behind a trusted proxy (nginx, ALB, etc.). Otherwise forwarded
# headers are ignored to prevent clients from spoofing their source IP.
TRUST_PROXY="false"

# ------------------------------------------------------------------------------
# 13. DEMO ENVIRONMENT GATING
# ------------------------------------------------------------------------------
# Set to "false" in full production with live payment gateway and real keys
DEMO_MODE="true"
# Optional site-wide access passkey (leave empty for open public access)
DEMO_ACCESS_PASSWORD=""
