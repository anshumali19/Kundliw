# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanad_jyotish?schema=public"

# NextAuth configuration
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-char-secret"
NEXTAUTH_URL="http://localhost:3000"

# Initial Admin Password (read on initial seed/setup only; never hardcoded)
INITIAL_ADMIN_PASSWORD="change-me-in-production"

# Google OAuth Credentials (optional in dev; leave empty if not configured)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay Payment Gateway Credentials (placeholders)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook"

# AstroSage Astrology API Adapter (placeholders)
ASTROSAGE_USER_ID=""
ASTROSAGE_API_KEY=""

# Private Storage for Customer Kundli Vault
VAULT_STORAGE_PATH="./storage/vault"

# Client Demo Mode (gates all mock / placeholder adapters)
DEMO_MODE="true"

# Trust X-Forwarded-For / X-Real-IP from a reverse proxy.
# Vercel and Cloudflare Pages are auto-detected; set this to "true" only when
# the app runs behind a trusted proxy (nginx, ALB, etc.). Otherwise forwarded
# headers are ignored to prevent clients from spoofing their source IP.
TRUST_PROXY="false"

# Optional Demo Access Gate (leave empty to disable; set to require passkey to enter site)
DEMO_ACCESS_PASSWORD=""

# Google Analytics Measurement ID (optional; loads gtag only when configured)
GA_MEASUREMENT_ID=""
